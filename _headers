# Cloudflare Pages response headers.
# https://developers.cloudflare.com/pages/configuration/headers/

# Site-wide safe defaults. No inline scripts anywhere on this site (only
# js/script.js, same-origin), so a fairly strict CSP is cheap here — tighten
# further if a future page adds a third-party embed.
/*
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; frame-ancestors 'none'; object-src 'none'; base-uri 'none'; form-action 'none'

# /pro is the only page with a third-party script: PayPal's checkout buttons.
# Replace the site-wide CSP there with one that also allows PayPal and the
# licence service (sandbox + live). Everything else stays as strict as above.
/pro
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-n8SeBQJ44hfg74TlDOKj4U2ORkgMfIj5ms8CC25yEBk=' https://www.paypal.com https://*.paypal.com https://*.paypalobjects.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com https://*.paypalobjects.com; img-src 'self' data: https://*.paypal.com https://*.paypalobjects.com; frame-src https://*.paypal.com https://*.paypalobjects.com; connect-src 'self' https://license.devandrepair.com https://license-service-sandbox.hassan-boulhilt.workers.dev https://*.paypal.com https://cloudflareinsights.com; frame-ancestors 'none'; object-src 'none'; base-uri 'none'; form-action 'none'
